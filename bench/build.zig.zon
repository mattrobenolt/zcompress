.{
    .name = .zcompress_bench,
    .version = "0.0.0",
    .fingerprint = 0x61555d402eb810a4, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The C-arm competitor sources (bench/README.md, "Arms"): release
        // tarballs pinned by url+hash, fetched only by this build root's
        // `bench-vendor` step (build.zig here; the repo root's build.zig
        // delegates to it). The root package's zon stays clean — the
        // harness's competitors are the harness's concern.
        .libdeflate = .{
            .url = "https://github.com/ebiggers/libdeflate/archive/refs/tags/v1.26.tar.gz",
            .hash = "N-V-__8AAEaRCwCsYb_rSsH72Pb6DNFQLSjdRzTFOVsJWcoB",
            .lazy = true,
        },
        .zlibng = .{
            .url = "https://github.com/zlib-ng/zlib-ng/archive/refs/tags/2.3.3.tar.gz",
            .hash = "N-V-__8AAPaJcABkB6U-96R7h2xuXX5TlDMvwPbE4PucPI59",
            .lazy = true,
        },
        .googlesnappy = .{
            .url = "https://github.com/google/snappy/archive/refs/tags/1.3.1.tar.gz",
            .hash = "N-V-__8AABSJMwBOXGG9fyC5Qh-ckIPIwe9UxsdUveKkzezo",
            .lazy = true,
        },
        .zstd = .{
            .url = "https://github.com/facebook/zstd/archive/refs/tags/v1.5.7.tar.gz",
            .hash = "N-V-__8AAPZ7fwBg4JoCzM_0o2A8wxH2hsUUeiU1iuZv53L5",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
